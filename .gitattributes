# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files to be normalized and checked out with LF
*.dart text
*.md text
*.yaml text
*.yml text
*.json text

# Windows scripts should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
